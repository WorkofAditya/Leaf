#!/usr/bin/env python3
import sys

from Modules.commands import (
    leaf_add,
    leaf_branch,
    leaf_checkout,
    leaf_clone,
    leaf_diff,
    leaf_export_git,
    leaf_fsck,
    leaf_ignore,
    leaf_import_git,
    leaf_init,
    leaf_log,
    leaf_merge,
    leaf_reset,
    leaf_restore,
    leaf_revert,
    leaf_save,
    leaf_status,
    leaf_tag,
    leaf_version,
)
from Modules.help import leaf_help


def main():
    if len(sys.argv) < 2:
        leaf_help()
        return 0

    command = sys.argv[1]

    if command == "init":
        leaf_init()
    elif command == "save":
        leaf_save(" ".join(sys.argv[2:]))
    elif command == "add":
        leaf_add(" ".join(sys.argv[2:]))
    elif command == "reset":
        if len(sys.argv) > 2 and sys.argv[2] in {"--hard", "--soft"}:
            target = sys.argv[3] if len(sys.argv) > 3 else None
            leaf_reset(sys.argv[2], target)
        else:
            leaf_reset(sys.argv[2] if len(sys.argv) > 2 else None)
    elif command == "revert":
        if len(sys.argv) < 3:
            print("🍂 Missing commit id")
            return 1
        leaf_revert(sys.argv[2])
    elif command == "log":
        leaf_log()
    elif command == "restore":
        if len(sys.argv) < 3:
            print("🍂 Missing commit id")
            return 1
        leaf_restore(sys.argv[2])
    elif command == "status":
        leaf_status()
    elif command == "diff":
        leaf_diff(sys.argv[2] if len(sys.argv) == 3 else None)
    elif command == "ignore":
        if len(sys.argv) < 3:
            print("🍂 Missing file/folder name")
            return 1
        leaf_ignore(" ".join(sys.argv[2:]))
    elif command == "branch":
        name = sys.argv[2] if len(sys.argv) > 2 else None
        commit_id = sys.argv[3] if len(sys.argv) > 3 else None
        leaf_branch(name, commit_id)
    elif command == "checkout":
        if len(sys.argv) < 3:
            print("🍂 Missing branch name")
            return 1
        leaf_checkout(sys.argv[2])
    elif command == "merge":
        if len(sys.argv) < 3:
            print("🍂 Missing branch name to merge")
            return 1
        leaf_merge(sys.argv[2])
    elif command == "tag":
        name = sys.argv[2] if len(sys.argv) > 2 else None
        commit_id = sys.argv[3] if len(sys.argv) > 3 else None
        leaf_tag(name, commit_id)
    elif command in {"remote", "fetch", "pull", "push"}:
        print("🍂 Remote repository commands are currently disabled")
    elif command == "clone":
        if len(sys.argv) < 3:
            print("🍂 Missing source path")
            return 1
        destination = sys.argv[3] if len(sys.argv) > 3 else None
        leaf_clone(sys.argv[2], destination)
    elif command == "import-git":
        leaf_import_git()
    elif command == "export-git":
        leaf_export_git()
    elif command == "fsck":
        leaf_fsck()
    elif command in {"help", "-h", "--help"}:
        leaf_help()
    elif command in {"version", "v", "-v"}:
        leaf_version()
    else:
        print(f"🍂 Unknown command: {command}")
        leaf_help()
        return 2

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
